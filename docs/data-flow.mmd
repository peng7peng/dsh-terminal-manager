%% dsh-terminal-manager 数据流图（数据流转路径）
%% 17 条主数据流（S5 远端传输 + port-log 扩展模块接入后）
%% ① 人工键入 ② 设备输出 ③ AI 发命令 ④ 广播 ⑤ 控制面 RPC ⑥ 本地文件读写
%% ⑦ TC 脚本执行 ⑧ 事件总线+状态推送 ⑨ 上传(本地源) ⑩ 上传(浏览器直传)
%% ⑪ 下载到工作区 ⑫ 另存为下载 ⑬ AI 文件传输
%% ⑭ 会话日志 ⑮ 会话共享 ⑯ 端口映射 ⑰ port-log 控制面+SSE
%% 更新日期：2026-09-05
graph TB

  %% ===== 外部 =====
  User([用户])
  AI([AI Agent])
  Device[("远端设备")]
  Store[("connections.json")]
  Disk[("本地文件系统")]
  ShareClient([共享客户端])
  MapClient([映射客户端])
  LogDisk[("日志文件<br/>dataDir/ext/port-log/")]

  %% ===== 浏览器半 =====
  subgraph Browser["浏览器半 (client/)"]
    direction TB
    F4["F4 TermView"]
    F3["F3 广播栏/网格"]
    F2["F2 连接面板"]
    F7["F7 本地文件面板"]
    F7b["F7b 远端文件面板"]
    F9["F9 编辑器"]
    F10["F10 TC 执行"]
    F5["F5 ws.ts"]
    FRpc["rpc.ts + HTTP"]
    FPL["PortLogWorkspace<br/>Mappings/Shares/Logs"]
    FPLRpc["port-log rpc + SSE"]
  end

  %% ===== host 半 =====
  subgraph Host["host 半 (src/)"]
    direction TB
    B7b["B7b /term-io WS"]
    B7a["B7a /term-manager HTTP"]
    B6["B6 tm_* ×8"]
    B4(("B4 SessionManager"))
    B8["B8 CommandGuard"]
    B5["B5 WaitPolicy"]
    B1["B1 ConnectionStore"]
    B10["B10 FileService"]
    B9["B9 EventBus"]
    B2["B2/B3 传输层"]
    Sftp["SftpFacade"]
    PLR["port-log Router<br/>/term-manager/ext/port-log"]
    PLMap["MappingManager<br/>TCP/UDP 转发"]
    PLShare["ShareManager<br/>Telnet 服务端"]
    PLLog["SessionLogManager"]
    PLSse["RuntimeEventHub<br/>SSE"]
  end

  %% ===== 流①：人工键入 =====
  User -->|"① 键盘按键"| F4
  F4 -->|"① input 帧"| F5
  F5 -->|"① WS /term-io"| B7b
  B7b -->|"① write() 不过守卫"| B4
  B4 -->|"① transport.write"| B2
  B2 -->|"① TCP"| Device

  %% ===== 流②：设备输出 =====
  Device -->|"② 输出字节"| B2
  B2 -->|"② onData"| B4
  B4 -->|"② 写缓冲+推订阅"| B7b
  B7b -->|"② output 帧"| F5
  F5 -->|"② 渲染"| F4

  %% ===== 流③：AI 发命令 =====
  AI -->|"③ tm_send"| B6
  B6 -->|"③ sendAndWait(guard)"| B4
  B4 -->|"③ checkCommand"| B8
  B4 -->|"③ transport.write"| B2
  B2 -->|"③ 命令→设备"| Device
  Device -->|"③ 输出流"| B2
  B2 -->|"③ feed"| B4
  B4 -->|"③ feed/poll"| B5
  B5 -->|"③ waitReason"| B4
  B4 -->|"③ 整段输出"| B6
  B6 -->|"③ 结果"| AI

  %% ===== 流④：广播 =====
  AI -->|"④ tm_send_all"| B6
  B6 -->|"④ broadcast"| B4
  User -->|"④ 广播栏"| F3
  F3 -->|"④ 逐台 ws.input"| F5

  %% ===== 流⑤：控制面 RPC =====
  F2 -->|"⑤ connections.*/sessions.*"| FRpc
  FRpc -->|"⑤ HTTP /term-manager"| B7a
  B7a -->|"⑤ CRUD"| B1
  B1 -->|"⑤ 读写"| Store
  B7a -->|"⑤ connect/disconnect/read/send"| B4

  %% ===== 流⑥：本地文件读写 =====
  F7 -->|"⑥ files.tree/read"| FRpc
  F9 -->|"⑥ Ctrl+S files.write"| FRpc
  B7a -->|"⑥ listLocal/readLocal/writeLocal"| B10
  B10 -->|"⑥ 树根校验"| Disk

  %% ===== 流⑦：TC 脚本执行 =====
  User -->|"⑦ 执行脚本"| F10
  F10 -->|"⑦ parseTcScript(前端)"| F10
  F10 -->|"⑦ 逐条 sessions.send"| FRpc
  B7a -->|"⑦ sendAndWait"| B4

  %% ===== 流⑧：事件总线 + 状态推送 =====
  B4 -->|"⑧ emit output/input/status"| B9
  B4 -->|"⑧ notify"| B7b
  B7b -->|"⑧ status 帧"| F5
  F5 -->|"⑧ 更新列表"| F3

  %% ===== 流⑨：上传（本地源） =====
  User -->|"⑨ 选本地文件上传"| F7b
  F7b -->|"⑨ files.uploadLocal"| FRpc
  FRpc -->|"⑨ HTTP"| B7a
  B7a -->|"⑨ upload(kind=local)"| B10
  B10 -->|"⑨ getSftp"| B4
  B4 --> B2
  B2 --> Sftp
  Sftp -->|"⑨ fastPut"| Device
  B7a -->|"⑨ file-progress"| B7b
  B7b -->|"⑨ 广播进度"| F5
  F5 --> F7b

  %% ===== 流⑩：上传（浏览器直传） =====
  User -->|"⑩ 拖拽文件"| F7b
  F7b -->|"⑩ POST /files/upload raw"| FRpc
  FRpc --> B7a
  B7a -->|"⑩ upload(kind=stream)"| B10
  B10 --> Sftp
  Sftp -->|"⑩ pumpStream"| Device

  %% ===== 流⑪：下载到工作区 =====
  User -->|"⑪ 下载到工作区"| F7b
  F7b -->|"⑪ files.downloadToLocal"| FRpc
  FRpc --> B7a
  B7a --> B10
  B10 --> Sftp
  Sftp -->|"⑪ fastGet"| Device
  B10 -->|"⑪ 临时+rename"| Disk

  %% ===== 流⑫：另存为下载 =====
  User -->|"⑫ 另存为"| F7b
  F7b -->|"⑫ GET /files/download"| FRpc
  FRpc --> B7a
  B7a --> B10
  B10 --> Sftp
  Sftp -->|"⑫ createReadStream"| Device
  B7a -->|"⑫ pipeline → HTTP"| FRpc
  FRpc -->|"⑫ 浏览器保存"| User

  %% ===== 流⑬：AI 文件传输 =====
  AI -->|"⑬ tm_upload/tm_download"| B6
  B6 -->|"⑬ upload/downloadToLocal"| B10
  B10 --> Sftp
  Sftp --> Device
  B10 --> Disk
  B6 -->|"⑬ TransferResult"| AI

  %% ===== 流⑭：会话日志（扩展模块订阅 output 写文件） =====
  B4 -.->|"⑭ emit output/status"| B9
  B9 -.->|"⑭ on(output/status)"| PLLog
  PLLog -.->|"⑭ sessions.get 校验"| B4
  PLLog -->|"⑭ 归一化+写流"| LogDisk

  %% ===== 流⑮：会话共享（外部 Telnet 客户端连入） =====
  ShareClient -->|"⑮ Telnet 连入"| PLShare
  PLShare -.->|"⑮ sessions.get 校验"| B4
  PLShare -.->|"⑮ on(output) 拿会话输出"| B9
  PLShare -->|"⑮ 转发输出给客户端"| ShareClient
  ShareClient -->|"⑮ 客户端键入"| PLShare
  PLShare -.->|"⑮ sessions.write 注入"| B4
  B4 -->|"⑮ transport.write"| B2
  B2 --> Device

  %% ===== 流⑯：端口映射（TCP/UDP 转发） =====
  MapClient -->|"⑯ TCP/UDP 连入"| PLMap
  PLMap -->|"⑯ 转发到目标"| Device
  Device -->|"⑯ 回程"| PLMap
  PLMap -->|"⑯ 回程"| MapClient

  %% ===== 流⑰：port-log 控制面 + SSE 推送 =====
  User -->|"⑰ 操作映射/共享/日志"| FPL
  FPL -->|"⑰ portLogRpc"| FPLRpc
  FPLRpc -->|"⑰ HTTP /term-manager/ext/port-log"| PLR
  PLR --> PLMap
  PLR --> PLShare
  PLR --> PLLog
  PLMap -->|"⑰ publish"| PLSse
  PLShare -->|"⑰ publish"| PLSse
  PLLog -->|"⑰ publish"| PLSse
  PLSse -->|"⑰ SSE /events"| FPLRpc
  FPLRpc -->|"⑰ 更新 UI"| FPL

  %% ===== file 事件（传输结束，扩展模块也订阅） =====
  B10 -.->|"emit file"| B9
  B9 -.->|"on(file) 写应用日志"| PLLog

  %% ===== 样式 =====
  classDef heart fill:#fde68a,stroke:#b45309,stroke-width:2px,color:#1c1917
  classDef actor fill:#fef3c7,stroke:#d97706,color:#1c1917
  classDef store fill:#e2e8f0,stroke:#475569,color:#1e293b
  classDef newmod fill:#dcfce7,stroke:#15803d,color:#14532d
  classDef extmod fill:#ede9fe,stroke:#6d28d9,color:#2e1065
  class B4 heart
  class User,AI,Device,ShareClient,MapClient actor
  class Store,Disk,LogDisk store
  class Sftp,F7b newmod
  class PLR,PLMap,PLShare,PLLog,PLSse,FPL,FPLRpc extmod
